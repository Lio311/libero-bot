# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres (pooled connection string, no quotes)
DATABASE_URL=

# Libero WooCommerce REST API (WP Admin → WooCommerce → Settings → Advanced → REST API, read access)
WC_URL=https://libero-il.co.il
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# Gmail sender + App Password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=
SMTP_PASS=
# Who gets the 08:00 email and failure alerts (comma-separated)
NOTIFY_TO=
# Without SMTP, MAIL_LOG=1 prints emails instead of sending them
# MAIL_LOG=1

# Dashboard URL (links in the email)
DASHBOARD_URL=http://localhost:3100

# Dashboard login. Empty passcode = open (local development only)
DASHBOARD_PASSCODE=
# Random string that signs the login cookie: openssl rand -hex 32
AUTH_SECRET=

# Mobile Web Push: identical values in Vercel and GitHub Actions secrets.
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI, e.g. mailto:your-real-email@example.com
VAPID_SUBJECT=
